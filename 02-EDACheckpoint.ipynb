   "metadata": {},
   "outputs": [],
   "source": [
    "vehicle_registrations = pd.read_csv(processed + \"vehicle_registrations.csv\")\n",
    "ev = vehicle_registrations[vehicle_registrations[\"fuel_type\"] == \"Electric\"].copy()\n",
