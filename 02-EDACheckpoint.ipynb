    "# 2. Convert the 'Month' column to datetime objects\n",
    "# Pandas is usually smart enough to infer the format\n",
    "df['Month'] = pd.to_datetime(df['Month'])\n",
    "\n",
    "# 3. Create a 'Year' column for grouping\n",
    "df['Year'] = df['Month'].dt.year\n",
