    "# 1. drop non-analytical columns\n",
    "federal_pt_clean_data = federal_pt_df.drop(columns=['NTD ID', 'Legacy NTD ID', 'Mode/Type of Service Status', 'Reporter Type', 'UACE CD', 'Mode', 'TOS', '3 Mode'])\n",
    "\n",
    "# 2. filter by city\n",
    "federal_pt_clean_data = federal_pt_clean_data[federal_pt_clean_data['UZA Name'].str.contains('Houston|San Francisco|New York', na=False)]\n",
    "\n",
    "# 3. select year column\n",
    "year_cols = [col for col in federal_pt_clean_data.columns if str(col).isdigit()]\n",
    "\n",
    "# 4. aggregate ridership across modes, keeping cities separate\n",
    "ridership = (\n",
    "    federal_pt_clean_data\n",
    "    .groupby('UZA Name', as_index=False)[year_cols]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "# 5. reshape to long format\n",
    "ridership = ridership.melt(\n",
    "    id_vars='UZA Name',\n",
    "    value_vars=year_cols,\n",
    "    var_name='year',\n",
    "    value_name='ridership'\n",
    ")\n",
    "\n",
    "# 6. rename column\n",
    "ridership = ridership.rename(columns={'UZA Name': 'city'})\n",
    "\n",
    "ridership.head()"
