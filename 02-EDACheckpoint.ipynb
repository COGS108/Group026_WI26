    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set visual style\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (12, 7)\n",
    "\n",
    "# 1. Load the cleaned data\n",
    "df = pd.read_csv('data/02-processed/combined_smoking_data_clean.csv')\n",
    "\n",
    "# 2. Create the Trend Plot (Line Plot)\n",
    "plt.figure(figsize=(14, 8))\n",
    "trend_plot = sns.lineplot(\n",
    "    data=df, \n",
    "    x='Year', \n",
    "    y='Current_Smoker_Pct', \n",
    "    hue='Geography', \n",
    "    marker='o', \n",
    "    linewidth=2.5,\n",
    "    palette='viridis'\n",
    ")\n",
    "\n",
    "plt.title('Adult Smoking Prevalence Trends: Houston vs. NYC vs. San Francisco', fontsize=16, fontweight='bold')\n",
    "plt.ylabel('Current Smoker Percentage (%)', fontsize=12)\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylim(0, 25) \n",
    "plt.legend(title='City', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "\n",
    "# Annotate the most recent data point for each city\n",
    "for geo in df['Geography'].unique():\n",
    "    subset = df[df['Geography'] == geo].sort_values('Year')\n",
    "    if not subset.empty:\n",
    "        recent = subset.iloc[-1]\n",
    "        plt.annotate(f\"{recent['Current_Smoker_Pct']}%\", \n",
    "                     xy=(recent['Year'], recent['Current_Smoker_Pct']),\n",
    "                     textcoords=\"offset points\", \n",
    "                     xytext=(0,10), \n",
    "                     ha='center', \n",
    "                     fontsize=10, \n",
    "                     fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
