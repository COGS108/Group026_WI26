    "#5. find outliers\n",
    "\n",
    "def find_outliers(df):\n",
    "    q1 = df.value.quantile(.25)\n",
    "    q3 = df.value.quantile(.75)\n",
    "    iqr = q3-q1\n",
    "    return df[(df.value < q1-1.5*iqr) | (df.value > q3+1.5*iqr)]\n",
    "\n",
    "outliers = air.groupby(\"pollutant\")[air.columns].apply(find_outliers)\n",
