   "source": [
    "The following code replaces the previous NYC secondhand smoke logic. It filters the dataset for citywide estimates, parses the numeric percentage from strings that include confidence intervals, and identifies any estimates flagged with an asterisk ($*$) for statistical instability."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 3. NYC Adult Cigarette Smoking ──────────────────────\n",
    "# File: 'NYC EH Data Portal - Cigarette smoking (adults) (full table).csv'\n",
    "nyc_raw = pd.read_csv('data/00-raw/' + 'NYC EH Data Portal - Cigarette smoking (adults) (full table).csv')\n",
    "\n",
    "# Filter for Citywide level to match the geographic scale of the other datasets\n",
    "nyc_city = nyc_raw[nyc_raw['GeoType'] == 'Citywide'].copy().reset_index(drop=True)\n",
    "\n",
    "def parse_nyc_smoking(val):\n",
    "    \"\"\"\n",
    "    Parses strings like '8.8 (7.9, 9.8)' or '7.2* (2.9, 17.1)'\n",
    "    to extract the point estimate and the instability flag (*).\n",
    "    \"\"\"\n",
    "    s = str(val)\n",
    "    unstable = '*' in s\n",
    "    # Extract the first decimal number found in the string\n",
    "    match = re.search(r'[\\d.]+', s)\n",
    "    pct = float(match.group()) if match else None\n",
    "    return pct, unstable\n",
    "\n",
    "# Apply the parser to the 'Percent' column\n",
    "nyc_pcts, nyc_unstable = [], []\n",
    "for v in nyc_city['Percent']:\n",
    "    p, u = parse_nyc_smoking(v)\n",
    "    nyc_pcts.append(p)\n",
    "    nyc_unstable.append(u)\n",
    "\n",
    "# Construct the processed NYC DataFrame\n",
    "nyc = pd.DataFrame({\n",
    "    'Year': nyc_city['TimePeriod'].astype(int),\n",
    "    'Geography': 'New York City, NY',\n",
    "    'Source': 'NYC EH Data Portal',\n",
    "    'Metric': 'Current Smoker % (Adults)',\n",
    "    'Current_Smoker_Pct': nyc_pcts,\n",
    "    'Statistically_Unstable': nyc_unstable,\n",
    "}).sort_values('Year').reset_index(drop=True)"
   ]
  },
